{
  "apiVersion": 1,
  "manifest": {
    "id": "com.example.text-tools", "name": "Text tools", "version": "0.1.0", "apiVersion": 1,
    "main": "dist/index.js", "commands": [{ "id": "uppercase", "title": "Uppercase text", "input": "text" }],
    "capabilities": ["clipboard.write"]
  },
  "messages": [
    {"direction":"hostToPlugin","message":{"jsonrpc":"2.0","id":"init-1","method":"initialize","params":{"apiVersion":1}}},
    {"direction":"pluginToHost","message":{"jsonrpc":"2.0","id":"init-1","result":{"apiVersion":1,"pluginID":"com.example.text-tools"}}},
    {"direction":"hostToPlugin","message":{"jsonrpc":"2.0","id":"command-1","method":"command","params":{"commandID":"uppercase","argument":"hello"}}},
    {"direction":"pluginToHost","message":{"jsonrpc":"2.0","id":"plugin:1","method":"clipboard.write","params":{"requestID":"command-1","text":"HELLO"}}},
    {"direction":"hostToPlugin","message":{"jsonrpc":"2.0","id":"plugin:1","result":null}},
    {"direction":"pluginToHost","message":{"jsonrpc":"2.0","id":"command-1","result":{"message":"Copied uppercase text"}}}
  ]
}
